HEDERA_RPC_URL=https://testnet.hashio.io/api
# 0x-prefixed 32-byte hex key; only needed for live submit/watch
RELAYER_PRIVATE_KEY=
# Overrides deployments. When unset, `submit --dry` runs offline (no snapshot read).
RISKGATE_ADDRESS=
# Optional; defaults to RiskGate.signer()
VERDICT_SIGNER_ADDRESS=
DEPLOYMENTS_FILE=../deployments/testnet.json
