# Simulator boot + liquidation-challenge wallet (needs Sepolia ETH; also calls join()).
CRE_ETH_PRIVATE_KEY=0x
# EIP-712 verdict signer. Never funded; RiskGate.signer() must equal its address.
CRE_VERDICT_SIGNER_KEY=0x
# Hedera relayer key, only read when bond-monitor runs with deliver=direct.
CRE_HEDERA_SUBMIT_KEY=0x
# Private coverage ladder, integers in bps: WARN > FREEZE; DEFAULT is a floor and 0 disables it.
# The live values are not in this repository. Pick your own: "Choosing a policy" in workflow/README.md.
CRE_BOND_WARN_BPS=<private, see workflow/README.md>
CRE_BOND_FREEZE_BPS=<private, see workflow/README.md>
CRE_BOND_DEFAULT_BPS=<private, see workflow/README.md>
# Private liquidation policy, integers: health factors x100 (TARGET > TRIGGER > 100),
# vUSD and vETH caps in 2-decimal token units, cooldown in seconds. Live values are not in this repository.
CRE_LIQ_TRIGGER_HF=<private, see workflow/README.md>
CRE_LIQ_TARGET_HF=<private, see workflow/README.md>
CRE_LIQ_MAX_REPAY_VUSD=<private, see workflow/README.md>
CRE_LIQ_MAX_DEPOSIT_VETH=<private, see workflow/README.md>
CRE_LIQ_COOLDOWN_SECS=<private, see workflow/README.md>
