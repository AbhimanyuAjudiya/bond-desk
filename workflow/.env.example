# Simulator boot + liquidation-challenge wallet (needs Sepolia ETH; also calls join()).
CRE_ETH_PRIVATE_KEY=0x
# EIP-712 verdict signer. Never funded; RiskGate.signer() must equal its address.
CRE_VERDICT_SIGNER_KEY=0x
# Hedera relayer key, only read when bond-monitor runs with deliver=direct.
CRE_HEDERA_SUBMIT_KEY=0x
# Private coverage thresholds (bps). 0 disables the DEFAULT floor.
CRE_BOND_WARN_BPS=13000
CRE_BOND_FREEZE_BPS=11000
CRE_BOND_DEFAULT_BPS=5000
# Private liquidation policy (HF x100, vUSD 2-dec, vETH 2-dec).
CRE_LIQ_TRIGGER_HF=115
CRE_LIQ_TARGET_HF=130
CRE_LIQ_MAX_REPAY_VUSD=300000
CRE_LIQ_MAX_DEPOSIT_VETH=200
CRE_LIQ_COOLDOWN_SECS=90
